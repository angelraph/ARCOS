# --- Arc Testnet ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER_URL=

# --- Circle Developer Console ---
# console.circle.com -> Keys -> Create a key -> API key -> Standard Key
CIRCLE_API_KEY=
# Generated once via the Circle SDK entity-secret helper, then registered in the console.
# Irreversible once registered — never regenerate unless the secret is compromised.
CIRCLE_ENTITY_SECRET=

# --- Deployer key (contracts/ Foundry scripts only, never the agent wallets) ---
DEPLOYER_PRIVATE_KEY=

# --- Circle Developer-Controlled Wallet IDs (filled in after Day 1 setup) ---
CIRCLE_WALLET_ID_TREASURY=
CIRCLE_WALLET_ID_PROCUREMENT=
CIRCLE_WALLET_ID_SUPPLIER=
CIRCLE_WALLET_ID_GOVERNANCE=
CIRCLE_WALLET_ID_CUSTOMER=

# --- Deployed contract addresses (filled in after Phase 1 deploy) ---
DECISION_LEDGER_ADDRESS=
TREASURY_POLICY_ADDRESS=
ESCROW_ADDRESS=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (delivery-confirmation vision validation, reused from arc-escrow) ---
OPENAI_API_KEY=
