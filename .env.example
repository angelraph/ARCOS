# --- Arc Testnet ---
ARC_TESTNET_RPC_URL=https://rpc.drpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER_URL=

# --- Circle Developer Console ---
# console.circle.com -> Keys -> Create a key -> API key -> Standard Key
CIRCLE_API_KEY=
# Generated once via the Circle SDK entity-secret helper, then registered in the console.
# Irreversible once registered — never regenerate unless the secret is compromised.
CIRCLE_ENTITY_SECRET=

# --- Deployer key (contracts/ Foundry scripts only, never the agent wallets) ---
DEPLOYER_PRIVATE_KEY=

# --- Circle Developer-Controlled Wallet IDs (filled in after Day 1 setup) ---
CIRCLE_WALLET_ID_TREASURY=
CIRCLE_WALLET_ID_PROCUREMENT=
CIRCLE_WALLET_ID_SUPPLIER=
CIRCLE_WALLET_ID_GOVERNANCE=
CIRCLE_WALLET_ID_CUSTOMER=

# --- Deployed contract addresses (filled in after Phase 1 deploy) ---
DECISION_LEDGER_ADDRESS=
TREASURY_POLICY_ADDRESS=
ESCROW_ADDRESS=

# --- Supabase (rationale text store — apps/agents/src/ledger.ts writes, apps/web/lib/rationales.ts reads) ---
# Create a project at supabase.com (or `vercel integration add supabase`), then run this
# once against it: create table rationales (rationale_hash text primary key, agent_id
# text not null, action_type text not null, rationale text not null, tx_ref text not
# null, ledger_tx_hash text not null, created_at timestamptz not null default now());
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (delivery-confirmation vision validation, reused from arc-escrow) ---
OPENAI_API_KEY=

# --- Circle Gateway (x402 Nanopayments) ---
# Procurement Agent pays the Supplier Agent's quote endpoint gas-free via Circle Gateway.
# This must be a raw local EOA private key, NOT a Circle wallet ID — Gateway/x402 payments
# require client-side EIP-3009 signing, which Circle's Developer-Controlled Wallets don't
# expose. Fund it with only a couple dollars of USDC + native gas (npm run setup-gateway
# deposits into its Gateway balance); it never touches treasury funds. Leave blank to skip
# this leg and fall back to an in-process (unpaid) quote.
PROCUREMENT_GATEWAY_PRIVATE_KEY=
SUPPLIER_QUOTE_FEE_USDC=0.02

# --- Circle Bridge Kit (CCTPv2) ---
# Standalone cross-chain treasury rebalance demo (scripts/bridge-treasury-demo.ts) —
# separate from the core payment->escrow flow. Same reasoning as the Gateway key above:
# must be a raw local EOA (fund via faucet.circle.com, Arc Testnet), never the real
# Treasury Agent's Circle Developer-Controlled Wallet. Leave blank to skip.
TREASURY_BRIDGE_PRIVATE_KEY=
